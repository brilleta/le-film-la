server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # DNS interne de Docker : l'IP du back est résolue à chaque requête (expire après 30 s),
    # nginx démarre même si le back est absent et le suit après un redéploiement.
    resolver 127.0.0.11 valid=30s;

    location /api/ {
        # Sans chemin dans l'URL (donc sans / final), proxy_pass conserve le préfixe /api.
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_set_header Host $proxy_host;
        # Le back limite la recherche IA par IP : il doit voir celle du visiteur.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_ssl_server_name on;
        # La recherche IA peut attendre 30 s, plus un nouvel essai, puis TMDB.
        proxy_read_timeout 90s;
    }

    # Les noms de fichiers contiennent un hash : ils peuvent être gardés indéfiniment.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
